{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Northstar Ledger brand tokens. Sampled from the live marketing site (prospect-site/index.html) and mapped to prototype/src/design-tokens.css. Client product kit — not Robosoft corporate branding.",
  "color": {
    "ink": {
      "$value": "#1c1914",
      "$type": "color",
      "$description": "Primary text. Site --ink. Prototype --color-fg."
    },
    "ink-soft": {
      "$value": "#4a453c",
      "$type": "color",
      "$description": "Secondary text from the live site (--ink-soft). Prefer this over prototype --color-fg-muted #5c564c when promoting Figma to source of truth."
    },
    "paper": {
      "$value": "#f6f1e8",
      "$type": "color",
      "$description": "Cream canvas. Site --paper. Prototype --color-bg."
    },
    "paper-2": {
      "$value": "#efe8db",
      "$type": "color",
      "$description": "Muted cream. Site --paper-2. Prototype --color-bg-muted."
    },
    "rule": {
      "$value": "#d8cfc0",
      "$type": "color",
      "$description": "Hairline / border. Site --rule. Prototype --color-rule."
    },
    "gold": {
      "$value": "#b8860b",
      "$type": "color",
      "$description": "Accent / star. Site --gold. Prototype --color-accent."
    },
    "gold-deep": {
      "$value": "#8a6508",
      "$type": "color",
      "$description": "Eyebrow and quiet-button hover. Site --gold-deep. Prototype --color-accent-deep."
    },
    "navy": {
      "$value": "#1e2a36",
      "$type": "color",
      "$description": "Primary button and pricing panel. Site --navy. Prototype --color-navy."
    },
    "white": {
      "$value": "#fffdf8",
      "$type": "color",
      "$description": "Elevated card surface. Site --white. Prototype --color-bg-elevated."
    },
    "good": {
      "$value": "#2f6b4f",
      "$type": "color",
      "$description": "Connected status. Prototype only (--color-good)."
    },
    "warn": {
      "$value": "#9a5b12",
      "$type": "color",
      "$description": "Needs-review status. Prototype only (--color-warn)."
    },
    "danger": {
      "$value": "#8f2d2d",
      "$type": "color",
      "$description": "Form error. Prototype only (--color-danger)."
    },
    "pricing-on-navy": {
      "$value": "#f4efe6",
      "$type": "color",
      "$description": "Text on navy pricing box. Site only."
    }
  },
  "color-semantic": {
    "bg": {
      "canvas": {
        "$value": "{color.paper}",
        "$type": "color",
        "$extensions": { "com.northstar.css": "--color-bg" }
      },
      "elevated": {
        "$value": "{color.white}",
        "$type": "color",
        "$extensions": { "com.northstar.css": "--color-bg-elevated" }
      },
      "muted": {
        "$value": "{color.paper-2}",
        "$type": "color",
        "$extensions": { "com.northstar.css": "--color-bg-muted" }
      }
    },
    "fg": {
      "primary": {
        "$value": "{color.ink}",
        "$type": "color",
        "$extensions": { "com.northstar.css": "--color-fg" }
      },
      "muted": {
        "$value": "{color.ink-soft}",
        "$type": "color",
        "$extensions": { "com.northstar.css": "--color-fg-muted" }
      },
      "on-navy": {
        "$value": "{color.pricing-on-navy}",
        "$type": "color"
      }
    },
    "accent": {
      "gold": {
        "$value": "{color.gold}",
        "$type": "color",
        "$extensions": { "com.northstar.css": "--color-accent" }
      },
      "gold-deep": {
        "$value": "{color.gold-deep}",
        "$type": "color",
        "$extensions": { "com.northstar.css": "--color-accent-deep" }
      }
    },
    "action": {
      "primary": {
        "$value": "{color.navy}",
        "$type": "color",
        "$extensions": { "com.northstar.css": "--color-navy" }
      }
    },
    "border": {
      "default": {
        "$value": "{color.rule}",
        "$type": "color",
        "$extensions": { "com.northstar.css": "--color-rule" }
      }
    },
    "status": {
      "good": {
        "$value": "{color.good}",
        "$type": "color",
        "$extensions": { "com.northstar.css": "--color-good" }
      },
      "warn": {
        "$value": "{color.warn}",
        "$type": "color",
        "$extensions": { "com.northstar.css": "--color-warn" }
      },
      "danger": {
        "$value": "{color.danger}",
        "$type": "color",
        "$extensions": { "com.northstar.css": "--color-danger" }
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$value": ["Newsreader", "Georgia", "serif"],
        "$type": "fontFamily",
        "$description": "Headlines. Site and prototype --font-display. Weight 550 (Figma: Medium / 500–600).",
        "$extensions": { "com.northstar.css": "--font-display" }
      },
      "body": {
        "$value": ["IBM Plex Sans", "Segoe UI", "sans-serif"],
        "$type": "fontFamily",
        "$description": "UI and body. Site and prototype --font-body.",
        "$extensions": { "com.northstar.css": "--font-body" }
      }
    },
    "size": {
      "xs": { "$value": "12px", "$type": "dimension", "$description": "0.75rem" },
      "sm": { "$value": "14.4px", "$type": "dimension", "$description": "0.9rem — prototype body-small / table" },
      "eyebrow": { "$value": "12.5px", "$type": "dimension", "$description": "0.78rem — site eyebrow" },
      "tag": { "$value": "11.5px", "$type": "dimension", "$description": "0.72rem — site .tag" },
      "nav": { "$value": "15.2px", "$type": "dimension", "$description": "0.95rem — site nav links" },
      "md": { "$value": "16px", "$type": "dimension", "$description": "1rem" },
      "lede": { "$value": "18.4px", "$type": "dimension", "$description": "1.15rem — site .lede" },
      "lg": { "$value": "20px", "$type": "dimension", "$description": "1.25rem" },
      "feature": { "$value": "23.2px", "$type": "dimension", "$description": "1.45rem — site feature h3" },
      "quote": { "$value": "24.8px", "$type": "dimension", "$description": "1.55rem — site quote" },
      "xl": { "$value": "32px", "$type": "dimension", "$description": "2rem — prototype KPI" },
      "h2-min": { "$value": "28.8px", "$type": "dimension", "$description": "clamp 1.8rem" },
      "h2-max": { "$value": "41.6px", "$type": "dimension", "$description": "clamp 2.6rem" },
      "2xl": { "$value": "44px", "$type": "dimension", "$description": "2.75rem — prototype h1" },
      "h1-min": { "$value": "38.4px", "$type": "dimension", "$description": "clamp 2.4rem" },
      "h1-max": { "$value": "68.8px", "$type": "dimension", "$description": "clamp 4.3rem" }
    },
    "weight": {
      "regular": { "$value": "400", "$type": "fontWeight" },
      "medium": { "$value": "500", "$type": "fontWeight", "$description": "Closest Figma match for CSS 550 headlines" },
      "semibold": { "$value": "600", "$type": "fontWeight" }
    },
    "line-height": {
      "tight": { "$value": "1.12", "$type": "number", "$description": "Site headlines 1.12; prototype --line-tight 1.15" },
      "quote": { "$value": "1.3", "$type": "number" },
      "body": { "$value": "1.55", "$type": "number", "$description": "Site body. Prototype --line-body is 1.5." }
    },
    "letter-spacing": {
      "display": { "$value": "-0.03em", "$type": "dimension" },
      "brand": { "$value": "-0.02em", "$type": "dimension" },
      "eyebrow": { "$value": "0.16em", "$type": "dimension" },
      "status": { "$value": "0.08em", "$type": "dimension" }
    }
  },
  "space": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "24px", "$type": "dimension" },
    "6": { "$value": "32px", "$type": "dimension" },
    "7": { "$value": "48px", "$type": "dimension" },
    "8": { "$value": "72px", "$type": "dimension" },
    "nav-gap": { "$value": "22px", "$type": "dimension" },
    "nav-min-height": { "$value": "68px", "$type": "dimension" },
    "card-padding": { "$value": "22px", "$type": "dimension", "$description": "Site .card padding" },
    "feature-padding": { "$value": "26px", "$type": "dimension" },
    "wrap": { "$value": "1120px", "$type": "dimension", "$description": "Site max content width" },
    "prototype-max": { "$value": "920px", "$type": "dimension", "$description": "Prototype --max-width" }
  },
  "radius": {
    "sm": { "$value": "8px", "$type": "dimension", "$description": "Prototype inputs" },
    "md": { "$value": "14px", "$type": "dimension", "$description": "Prototype tool / KPI tiles" },
    "feature": { "$value": "16px", "$type": "dimension", "$description": "Site .feature" },
    "card": { "$value": "18px", "$type": "dimension", "$description": "Site .card / .pricing-box. Prefer this for Card / Spend summary." },
    "lg": { "$value": "20px", "$type": "dimension", "$description": "Prototype .panel" },
    "pill": { "$value": "999px", "$type": "dimension" }
  },
  "shadow": {
    "card": {
      "$value": {
        "color": "#1c191414",
        "offsetX": "0px",
        "offsetY": "18px",
        "blur": "40px",
        "spread": "0px"
      },
      "$type": "shadow",
      "$description": "Site --shadow: 0 18px 40px rgba(28, 25, 20, 0.08). Prototype uses 16/36."
    }
  }
}
